# Copy to .env.local for local development; set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# Leave RESEND_API_KEY empty and the forms still work: enquiries are written
# to the server log instead of emailed.

# API key from https://resend.com (free plan: 3,000 emails/month, 100/day).
RESEND_API_KEY=

# Sender on a domain verified in Resend (add Resend's DNS records at ムームーDNS).
MAIL_FROM=VNT GROUP <noreply@vntgroup.co.jp>

# Where enquiries land. Comma-separate for several recipients
# (each recipient counts as one email against the Resend quota).
MAIL_TO=sales-1@vntgroup.co.jp
