# Copy to .env.local for local development; set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# Without SMTP_USER / SMTP_PASS the contact form shows an error instead of
# pretending to send, and the enquiry is only written to the server log.

# Google account the site sends from (Gmail / Google Workspace SMTP).
SMTP_USER=netadmin@vntgroup.co.jp
# Google *app password* (16 characters) for SMTP_USER. Requires 2-Step
# Verification on that account. Never put the account's real password here.
SMTP_PASS=

# Where enquiries land. Comma-separate for several recipients.
MAIL_TO=sales-1@vntgroup.co.jp

# Optional; defaults shown. Only change for a non-Google mail server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
